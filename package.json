{
  "name": "freewispr-voice-assistant",
  "version": "1.1.0",
  "description": "FreeWispr - Modern Windows Voice Typing & AI Assistant built with Electron, React, OmniRoute & OpenRouter",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder --win dir -c.win.signAndEditExecutable=false"
  },
  "keywords": [
    "freewispr",
    "free-wispr",
    "voice-typing",
    "whisper",
    "wispr-flow",
    "electron",
    "react",
    "openrouter",
    "omniroute",
    "stt",
    "ai-assistant"
  ],
  "author": "Shawon Sarkar",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "form-data": "^4.0.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.freewispr.voicetyping",
    "productName": "FreeWispr Voice Assistant",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "dir",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
